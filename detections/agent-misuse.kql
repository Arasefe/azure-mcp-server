// azsec-mcp: misuse of the AI agent's tool server, and tampering with its audit trail.
// Source: AzSecMcpAudit_CL (shipped by azsec-mcp-ship, infra/audit-ingestion.bicep).
// Suggested scheduled analytics rule: run every 15 minutes, look back 1 hour,
// one alert per row, entity mapping Host -> Host. MITRE: T1562 (Impair Defenses),
// T1070 (Indicator Removal) for the integrity findings.
let lookback = 1h;
let audit = AzSecMcpAudit_CL | where TimeGenerated > ago(lookback);
// 1. A destructive tool (wipe, delete, role grant, alert/incident close) was refused or declined.
let destructive_refused = audit
    | where Kind == "call" and Tier == "destructive" and Decision in ("denied", "declined")
    | project TimeGenerated, Host, Finding = "Destructive agent tool call refused or declined",
        Severity = "High", Tools = pack_array(Tool), Count = 1, Detail = Reason;
// 2. Repeated refusals in a short window: an agent probing its limits, often after prompt injection.
let refusal_burst = audit
    | where Kind == "call" and (Decision in ("denied", "declined") or Outcome == "refused")
    | summarize Count = count(), Tools = make_set(Tool, 20), TimeGenerated = max(TimeGenerated)
        by Host, Window = bin(TimeGenerated, 10m)
    | where Count > 3
    | project TimeGenerated, Host, Finding = "Burst of refused agent tool calls", Severity = "Medium",
        Tools, Count, Detail = strcat(Count, " refusals in 10 minutes");
// 3. The shipper found the local chain edited, truncated or rewritten.
let integrity = audit
    | where Kind == "heartbeat" and ChainOk == false
    | project TimeGenerated, Host, Finding = "azsec-mcp audit chain integrity failure",
        Severity = "High", Tools = dynamic([]), Count = 1, Detail = Problem;
// 4. A host that used to send heartbeats went quiet (shipper stopped or log removed).
let silent = AzSecMcpAudit_CL
    | where TimeGenerated > ago(7d) and Kind == "heartbeat"
    | summarize TimeGenerated = max(TimeGenerated) by Host
    | where TimeGenerated < ago(30m)
    | project TimeGenerated, Host, Finding = "azsec-mcp audit heartbeat missing", Severity = "Medium",
        Tools = dynamic([]), Count = 1, Detail = strcat("last heartbeat ", TimeGenerated);
union destructive_refused, refusal_burst, integrity, silent
| order by TimeGenerated desc
